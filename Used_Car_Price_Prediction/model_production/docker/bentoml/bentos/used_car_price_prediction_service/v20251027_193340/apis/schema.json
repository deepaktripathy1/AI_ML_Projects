                  "required": [
                    "make_year",
                    "accidents_reported",
                    "fuel_type",
                    "brand",
                    "transmission",
                    "color",
                    "insurance_valid",
                    "mileage_kmpl",
                    "engine_cc",
                    "owner_count"
