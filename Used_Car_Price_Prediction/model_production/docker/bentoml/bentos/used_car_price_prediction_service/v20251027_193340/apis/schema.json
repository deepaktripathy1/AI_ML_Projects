          "batch_metadata": {
            "description": "Batch processing metadata",
            "title": "Batch Metadata",
            "type": "object"
          }
        },
        "required": [
          "predictions",
          "batch_metadata"
        ],
        "title": "BatchPredictionOutputIODescriptor",
        "type": "object"
      },
      "is_task": false
    },
