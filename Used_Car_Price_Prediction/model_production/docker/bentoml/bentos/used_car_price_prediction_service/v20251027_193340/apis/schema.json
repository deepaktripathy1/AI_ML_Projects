                      "minimum": 0.0,
                      "type": "number"
                    },
                    "engine_cc": {
                      "description": "Engine capacity in cc",
                      "maximum": 100000,
                      "minimum": 0,
                      "title": "Engine Cc",
                      "type": "integer"
                    },
                    "owner_count": {
