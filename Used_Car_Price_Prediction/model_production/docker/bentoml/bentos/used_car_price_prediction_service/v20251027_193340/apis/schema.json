                "predicted_price": {
                  "description": "Predicted car price",
                  "title": "Predicted Price",
                  "type": "number"
                },
                "confidence_score": {
                  "description": "95% confidence interval",
                  "title": "Confidence Score",
                  "type": "number"
                },
                "input_validation": {
                  "description": "Input validation results",
                  "title": "Input Validation",
                  "type": "object"
                },
                "preprocessing_info": {
                  "description": "Preprocessing steps applied",
                  "title": "Preprocessing Info",
                  "type": "object"
                },
